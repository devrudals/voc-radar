{
  "manifest_version": 3,
  "name": "VOCRadar - E-commerce Review & Opportunity Miner",
  "version": "1.0.0",
  "description": "Extract fatal flaws, unmet customer desires, and winning ad copy from Amazon & Coupang in 1-click.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.co.uk/*",
    "*://*.coupang.com/*",
    "*://*.smartstore.naver.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze Product Reviews with VOCRadar"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.coupang.com/*",
        "*://*.smartstore.naver.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
